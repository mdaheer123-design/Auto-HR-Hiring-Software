# Friday HR Platform

# === Authentication ===
JWT_SECRET_KEY=your-super-secret-key-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# === Database ===
DATABASE_URL=sqlite:///./friday.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:pass@host:5432/friday

# === Resume Parser (Affinda / RChilli) ===
AFFINDA_API_KEY=your_affinda_api_key
AFFINDA_WORKSPACE_ID=your_workspace_id
RCHILLI_API_KEY=your_rchilli_api_key
RCHILLI_USER_KEY=your_rchilli_user_key

# === Embeddings (BGE-M3 self-hosted / HuggingFace) ===
BGE_M3_MODEL_PATH=BAAI/bge-m3

# === Embeddings & Search (Elasticsearch) ===
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=

# === AI Screening (Google Gemini) ===
GEMINI_API_KEY=your_gemini_api_key

# === HR Chatbot (Groq / Grok) ===
GROK_API_KEY=your_groq_api_key

# === Email — SMTP (fallback) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@example.com

# === File Storage ===
UPLOAD_DIR=./uploads
# AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ── Auto Cleanup Job ──
AUTO_CLEANUP_ENABLED=true
AUTO_CLEANUP_DAYS=7
AUTO_PURGE_DAYS=90
